FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless make curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir -e '.[dev]' 2>/dev/null || pip install --no-cache-dir .
COPY . .
ENV PYTHONPATH=/app DBT_PROFILES_DIR=/app/warehouse SPARK_MASTER=local[2]
CMD ["sleep", "infinity"]
